# ════════════════════════════════════════════════════════════════
#  AutoBot v2 — Environment Variables
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ── LinkedIn Credentials ─────────────────────────────────────────
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile-id

# ── LLM Provider (pick ONE — set at test time) ───────────────────
# Option A: OpenAI
OPENAI_API_KEY=sk-...

# Option B: Google Gemini
GEMINI_API_KEY=...

# Which provider to use: "openai" or "gemini"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o           # or gemini-1.5-pro

# Embeddings model
EMBEDDINGS_PROVIDER=openai          # or "gemini"
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Qdrant (Vector DB) ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=autobot_profile

# ── Browser ──────────────────────────────────────────────────────
HEADLESS=false             # false = see the browser (recommended)

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ════════════════════════════════════════════════════════════════
#  AutoBot v2 — Environment Variables
#  Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ── LinkedIn Credentials ─────────────────────────────────────────
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/your-profile-id

# ── LLM Provider (pick ONE) ───────────────────────────────────────
# Option A: Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=

# Option B: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option C: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Which provider to use: "anthropic", "openai", or "gemini"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022   # or gpt-4o, gemini-1.5-pro

# Embeddings model: "local" (zero-dependency, offline), "openai", or "gemini"
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# ── Qdrant (Vector DB) ───────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=autobot_profile

# ── Browser ──────────────────────────────────────────────────────
HEADLESS=false             # false = see the browser (recommended)

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
